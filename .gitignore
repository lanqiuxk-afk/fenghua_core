# ---------------------------------------------------------------------------
#  构建产物
# ---------------------------------------------------------------------------
build/
build_*/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
.ninja_deps
.ninja_log
compile_commands.json

# ---------------------------------------------------------------------------
#  编译中间件 / 二进制
#  注意: 这里不忽略 libs/**, 因为内核驱动的静态库 (如 libparadise_api.a)
#        如果决定随仓库发布, 需要显式提交。默认建议不提交, 见下面注释。
# ---------------------------------------------------------------------------
*.o
*.obj
*.a
*.so
# 例外: 采集降权要链接的预编译库, 必须随仓库 (见 third_party/NOTICE.md)
!libs/**/*.so
!libs/**/*.a
*.dylib
*.exe
*.pdb
*.ilk
*.exp
*.idb

# 驱动静态库: 默认不提交 (各 ABI 一份, 体积大且通常有分发限制)。
# 若你的驱动允许随仓库发布, 删掉下面这行的注释。
# libs/

# Android 打包产物
*.apk
*.ap_
*.dex
*.class
*.jar
*.keystore
*.jks
*.idsig
stub_build/

# ---------------------------------------------------------------------------
#  运行时产物 (不应进仓库)
# ---------------------------------------------------------------------------
*.log
fenghua_*/
*.pid
core
core.*
*.ppm
frames/

# 用户配置: 只提交 configs/mappings.example.json, 别提交自己的映射
mappings.json
*.macros
screen.json
card.key
theme.cfg

# ---------------------------------------------------------------------------
#  编辑器 / IDE / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.vs/
.cache/
CLion*/
.vscode/ipch/
*.user
*.suo

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*

# Linux
*~
.directory
